<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".SistApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sist"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sist"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".presentation.widget.PortfolioWidgetReceiver"
            android:configure=".presentation.widget.WidgetThemeConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/portfolio_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.BudgetWidgetReceiver"
            android:configure=".presentation.widget.WidgetThemeConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budget_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.NetWorthWidgetReceiver"
            android:configure=".presentation.widget.WidgetThemeConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/networth_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.QuickAddWidgetReceiver"
            android:configure=".presentation.widget.WidgetThemeConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quickadd_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.DistributionWidgetReceiver"
            android:configure=".presentation.widget.WidgetThemeConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/distribution_widget_info" />
        </receiver>

        <receiver
            android:name=".presentation.widget.WatchlistWidgetReceiver"
            android:configure=".presentation.widget.WatchlistConfigureActivity"
            android:exported="true"
            android:widgetFeatures="configuration_optional"
            tools:targetApi="p">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>

        <activity
            android:name=".presentation.widget.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Sist"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.widget.WatchlistConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.widget.WidgetThemeConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".worker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
