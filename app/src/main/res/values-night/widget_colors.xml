<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sist widget tasarim token'lari - koyu tema.
         Degerler DarkSistColors ile birebir eslenir. -->

    <!-- Yuzeyler -->
    <color name="widget_background">#0F1512</color>
    <color name="widget_surface">#171D1A</color>
    <color name="widget_surface_variant">#2C322F</color>
    <color name="widget_outline">#3F4945</color>
    <color name="widget_track">#2C322F</color>

    <!-- Metin -->
    <color name="widget_text_primary">#F6FBF8</color>
    <color name="widget_text_secondary">#BFC9C3</color>

    <!-- Finansal anlam renkleri -->
    <color name="widget_positive">#4EDC9D</color>
    <color name="widget_positive_container">#0C3A28</color>
    <color name="widget_negative">#FF7B7B</color>
    <color name="widget_negative_container">#431A1A</color>
    <color name="widget_warning">#FBBF24</color>

    <!-- Altin vurgu -->
    <color name="widget_gold">#E8C15C</color>
    <color name="widget_gold_container">#46370A</color>

    <!-- Hero yuzey: her iki temada derin yesil-siyah -->
    <color name="widget_hero">#06281C</color>
    <color name="widget_hero_variant">#0B3A2A</color>
    <color name="widget_on_hero">#EDFBF4</color>
    <color name="widget_on_hero_muted">#A9D9C6</color>

    <!-- Hero uzerinde kullanilan finansal renkler (tema bagimsiz) -->
    <color name="widget_on_hero_positive">#4EDC9D</color>
    <color name="widget_on_hero_positive_container">#0C3A28</color>
    <color name="widget_on_hero_negative">#FF7B7B</color>
    <color name="widget_on_hero_negative_container">#431A1A</color>
    <color name="widget_on_hero_warning">#FBBF24</color>
    <color name="widget_on_hero_gold">#E8C15C</color>
    <color name="widget_on_hero_gold_container">#46370A</color>

    <!-- Kategori vurgulari -->
    <color name="widget_category_yellow">#FACC15</color>
    <color name="widget_category_yellow_container">#3B2F05</color>
    <color name="widget_category_blue">#60A5FA</color>
    <color name="widget_category_blue_container">#10294A</color>
    <color name="widget_category_purple">#C084FC</color>
    <color name="widget_category_purple_container">#2E1445</color>
    <color name="widget_category_orange">#FB923C</color>
    <color name="widget_category_orange_container">#3F2008</color>

    <!-- Eski isimler, geriye donuk uyumluluk -->
    <color name="widget_profit">@color/widget_positive</color>
    <color name="widget_loss">@color/widget_negative</color>
</resources>
