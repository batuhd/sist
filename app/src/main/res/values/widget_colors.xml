<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sist widget tasarim token'lari. Tum degerler SistColors.kt ile birebir eslenir.
         Koyu tema icin values-night/widget_colors.xml kullanilir. -->

    <!-- Yuzeyler -->
    <color name="widget_background">#F6FBF8</color>
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_surface_variant">#DBE5DF</color>
    <color name="widget_outline">#BFC9C3</color>
    <color name="widget_track">#DBE5DF</color>

    <!-- Metin -->
    <color name="widget_text_primary">#171D1A</color>
    <color name="widget_text_secondary">#6F7974</color>

    <!-- Finansal anlam renkleri -->
    <color name="widget_positive">#0E7A55</color>
    <color name="widget_positive_container">#DDF5E9</color>
    <color name="widget_negative">#C43B3B</color>
    <color name="widget_negative_container">#FBE6E6</color>
    <color name="widget_warning">#B45309</color>

    <!-- Altin vurgu -->
    <color name="widget_gold">#A97C0B</color>
    <color name="widget_gold_container">#FFF0CD</color>

    <!-- Hero yuzey: her iki temada derin yesil-siyah -->
    <color name="widget_hero">#06281C</color>
    <color name="widget_hero_variant">#0B3A2A</color>
    <color name="widget_on_hero">#EDFBF4</color>
    <color name="widget_on_hero_muted">#A9D9C6</color>

    <!-- Hero uzerinde kullanilan finansal renkler (tema bagimsiz) -->
    <color name="widget_on_hero_positive">#4EDC9D</color>
    <color name="widget_on_hero_positive_container">#0C3A28</color>
    <color name="widget_on_hero_negative">#FF7B7B</color>
    <color name="widget_on_hero_negative_container">#431A1A</color>
    <color name="widget_on_hero_warning">#FBBF24</color>
    <color name="widget_on_hero_gold">#E8C15C</color>
    <color name="widget_on_hero_gold_container">#46370A</color>

    <!-- Kategori vurgulari -->
    <color name="widget_category_yellow">#EAB308</color>
    <color name="widget_category_yellow_container">#FEF3C7</color>
    <color name="widget_category_blue">#2F80ED</color>
    <color name="widget_category_blue_container">#E1EDFE</color>
    <color name="widget_category_purple">#9B51E0</color>
    <color name="widget_category_purple_container">#F2E8FC</color>
    <color name="widget_category_orange">#F2994A</color>
    <color name="widget_category_orange_container">#FDEEE0</color>

    <!-- Eski isimler, geriye donuk uyumluluk -->
    <color name="widget_profit">@color/widget_positive</color>
    <color name="widget_loss">@color/widget_negative</color>
</resources>
